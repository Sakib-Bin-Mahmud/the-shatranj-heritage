APP_NAME="The Shatranj Heritage API"
ENVIRONMENT=development
DEBUG=true
# When true, POST /auth/forgot-password echoes the reset token in its
# response (no email/SMS provider until Phase 7). Must be false in any
# environment real users can reach.
API_V1_PREFIX=/api/v1

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# The customer-facing web app — payment-gateway redirects (success/fail/
# cancel) land here, not on this API.
FRONTEND_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://shatranj:shatranj@localhost:5432/shatranj_heritage

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=shatranj-heritage

JWT_SECRET_KEY=change-me-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

SENTRY_DSN=
LOG_LEVEL=INFO
