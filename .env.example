# Copy to .env and adjust as needed. Consumed by docker-compose.yml for
# variable substitution, and passed through to the api service as its
# runtime environment (see apps/api/.env.example for the full list of
# variables the API itself understands).

POSTGRES_USER=shatranj
POSTGRES_PASSWORD=shatranj
POSTGRES_DB=shatranj_heritage

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=shatranj-heritage

JWT_SECRET_KEY=change-me-in-every-environment
SENTRY_DSN=

NEXT_PUBLIC_API_URL=http://localhost:8000
# Must resolve from the browser, not just from the api container — see
# apps/api's S3_ENDPOINT_URL, which product/category image URLs are
# built from. Used by next.config.ts to allowlist the host for
# next/image's optimizer.
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:9000
